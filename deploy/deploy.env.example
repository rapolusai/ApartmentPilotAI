# Copy to /opt/apartmentcare/deploy.env on the server (not secret).
AWS_REGION=ap-south-1
ECR_REGISTRY=446701321630.dkr.ecr.ap-south-1.amazonaws.com
ECR_REPO=apartmentcare-prod
BACKUP_BUCKET=apartmentcare-prod-backups-446701321630
SSM_PREFIX=/apartmentcare/prod
DOMAIN=api.apartmentcare.rapolu.in

